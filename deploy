#!/bin/bash
set -eo pipefail
#
# This script requires `PermitUserEnvironment yes`
# to be set on the remote hosts /etc/ssh/sshd_config
#
# IMPORTANT: keep the SSH payload below as a single-quoted heredoc. Single
# quotes and double quotes are safe inside that heredoc body. Do not turn it
# back into `ssh host '...'`: then any apostrophe inside the remote script,
# even in a comment, closes the local quote and can make `git diff` execute as
# plain `diff` or `git reset` execute as terminal `reset`.

usage() {
  echo "Usage: ./deploy [--force-bundle|--bundle]"
  echo
  echo "Options:"
  echo "  --force-bundle  Run bundle install even when Gemfile inputs are unchanged,"
  echo "                  and use a full Puma restart. Useful after changing ignored"
  echo "                  Ruby/runtime files on the server."
  echo "                  Alias: --bundle."
  echo "  -h, --help      Show this help."
}

FORCE_BUNDLE=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --force-bundle|--bundle)
      FORCE_BUNDLE=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown deploy argument: $1"
      echo
      usage
      exit 1
      ;;
  esac
  shift
done

echo "Deployanatoring teh codez!"
if [ "$FORCE_BUNDLE" -eq 1 ]; then
  echo "Forcing bundle install and full Puma restart."
fi
echo

# handle git and bundle install
ssh alonetone 'bash -s' -- "$FORCE_BUNDLE" <<'REMOTE_SCRIPT'
  set -eo pipefail

  FORCE_BUNDLE="$1"

  cd /data/alonetone

  export BUNDLE_CACHE_PATH="/home/deploy"
  export HOME="/home/deploy"
  BUNDLE_PATH="/home/deploy/.rbenv/shims/bundle"
  BUNDLE_COMMAND=(sudo -u deploy RAILS_ENV=production "$BUNDLE_PATH")
  GIT_COMMAND=(sudo -u deploy git)
  PUMA_PID_FILE=tmp/puma.pid

  show_puma_processes() {
    if [ ! -f "$PUMA_PID_FILE" ]; then
      echo "No Puma PID file at $PUMA_PID_FILE"
      return
    fi

    local puma_master_pid
    puma_master_pid="$(cat "$PUMA_PID_FILE")"
    if [ -z "$puma_master_pid" ]; then
      echo "Puma PID file is empty"
      return
    fi

    local child_pids
    child_pids="$(pgrep -P "$puma_master_pid" || true)"
    if [ -z "$child_pids" ]; then
      echo "No Puma child processes found for master $puma_master_pid"
      return
    fi

    ps -o pid,start,cmd -p $child_pids
  }

  echo "Telling sidekiq to chill on new jobs..."
  sudo systemctl restart sidekiq

  # Catches unstaged changes, staged changes, AND untracked files.
  git_status="$("${GIT_COMMAND[@]}" status --porcelain)"
  if [ -n "$git_status" ]; then
    echo "ERROR: local changes on server, exiting!"
    "${GIT_COMMAND[@]}" status --short
    exit 1
  fi

  "${GIT_COMMAND[@]}" fetch origin

  OLD_REV="$("${GIT_COMMAND[@]}" rev-parse HEAD)"
  NEW_REV="$("${GIT_COMMAND[@]}" rev-parse origin/main)"

  RUN_MIGRATIONS=0
  bundle_inputs_changed=0
  ruby_version_changed=0
  yarn_inputs_changed=0

  if ! "${GIT_COMMAND[@]}" diff --quiet "$OLD_REV" "$NEW_REV" -- db; then
    RUN_MIGRATIONS=1
  fi

  if ! "${GIT_COMMAND[@]}" diff --quiet "$OLD_REV" "$NEW_REV" -- Gemfile Gemfile.lock; then
    bundle_inputs_changed=1
  fi

  # Anchor on the leading +/- and a literal "puma " token so we only match
  # Puma gem version changes, not puma_worker_killer, puma-status, etc.
  puma_version_changed="$("${GIT_COMMAND[@]}" diff "$OLD_REV" "$NEW_REV" -- Gemfile.lock | awk '/^[+-][[:space:]]+puma[[:space:]]/ { count++ } END { print count + 0 }')"

  if ! "${GIT_COMMAND[@]}" diff --quiet "$OLD_REV" "$NEW_REV" -- .ruby-version; then
    ruby_version_changed=1
  fi

  if ! "${GIT_COMMAND[@]}" diff --quiet "$OLD_REV" "$NEW_REV" -- package.json yarn.lock; then
    yarn_inputs_changed=1
  fi

  # Force back onto main and discard any detached-HEAD / wrong-branch state.
  # A previous outage recovery left this repo on a random commit because the
  # old `git diff` check was happy with detached HEAD.
  if "${GIT_COMMAND[@]}" show-ref --verify --quiet refs/heads/main; then
    "${GIT_COMMAND[@]}" checkout main
  else
    "${GIT_COMMAND[@]}" checkout -b main --track origin/main
  fi
  "${GIT_COMMAND[@]}" reset --hard "$NEW_REV"

  # Sanity check: working copy is now exactly at origin/main.
  DEPLOYED_REV="$("${GIT_COMMAND[@]}" rev-parse HEAD)"
  if [ "$DEPLOYED_REV" != "$NEW_REV" ]; then
    echo "ERROR: HEAD did not land on origin/main after reset, exiting!"
    exit 1
  fi
  echo "Deploying $("${GIT_COMMAND[@]}" rev-parse --short HEAD) ($("${GIT_COMMAND[@]}" log -1 --pretty=%s))"

  if [ "$bundle_inputs_changed" -eq 1 ] || [ "$FORCE_BUNDLE" -eq 1 ]; then
    if [ "$bundle_inputs_changed" -eq 1 ]; then
      echo "Gemfile or Gemfile.lock changed, bundle installing..."
    else
      echo "Bundle install was forced by deploy argument."
    fi
    "${BUNDLE_COMMAND[@]}" install
    echo
  else
    echo "skipping bundle install, Gemfile and Gemfile.lock have not changed since last time."
    echo
  fi

  # Shakapacker 7+ no longer auto-runs yarn install during assets:precompile,
  # so we need to install JS deps explicitly before webpack compiles.
  if [ "$yarn_inputs_changed" -eq 1 ]; then
    echo "package.json or yarn.lock changed, yarn installing..."
    sudo -u deploy yarn install --frozen-lockfile || { echo "yarn install failed, aborting deploy"; exit 1; }
  else
    echo "skipping yarn install, package.json and yarn.lock have not changed since last time."
  fi

  if [ "$RUN_MIGRATIONS" -eq 1 ]; then
    echo "Running migrations, hold tight..."
    time "${BUNDLE_COMMAND[@]}" exec rake db:migrate
  fi

  echo "Compiling assets..."
  time "${BUNDLE_COMMAND[@]}" exec rake assets:precompile || { echo "assets:precompile failed, aborting deploy"; exit 1; }

  echo ""
  echo "Processes before restart"
  show_puma_processes

  # Phased restart re-execs workers off the existing master, so it picks up
  # app/gem changes (we use prune_bundler) but NOT a new Puma binary or a new
  # Ruby. Those are bound to the master process, so force a full restart in
  # those cases.
  if [ "$puma_version_changed" -gt 0 ] || [ "$ruby_version_changed" -gt 0 ] || [ "$FORCE_BUNDLE" -eq 1 ]; then
    if [ "$puma_version_changed" -gt 0 ] || [ "$ruby_version_changed" -gt 0 ]; then
      echo "Puma or Ruby version changed, full restart"
    else
      echo "Full restart was forced by deploy argument."
    fi
    "${BUNDLE_COMMAND[@]}" exec pumactl restart
  else
    echo "Run puma, run! (phased restart)"
    "${BUNDLE_COMMAND[@]}" exec pumactl phased-restart
  fi

  # Actually cycle sidekiq
  echo "Kiq sidekiq back to work"
  sudo systemctl restart sidekiq

  sleep 3

  echo ""
  echo "Processes during restart"
  show_puma_processes

  sleep 5

  echo ""
  echo "Processes end of restart"
  show_puma_processes

  sleep 5

  echo ""
  echo "Processes end of restart"
  show_puma_processes
REMOTE_SCRIPT

REVISION="$(ssh alonetone 'cd /data/alonetone && sudo -u deploy git rev-parse --short HEAD')"
echo "Notifying bugsnag of revision release $REVISION"
curl https://build.bugsnag.com/ \
  --header "Content-Type: application/json" \
  --data '{
    "apiKey": "'"$BUGSNAG_KEY"'",
    "appVersion": "'"$REVISION"'",
    "releaseStage": "production",
    "sourceControl": {
      "provider": "github",
      "repository": "https://github.com/sudara/alonetone",
      "revision": "'"${REVISION}"'"
    }
  }'

# Skip silently when keys aren't in the local env (e.g. deploying from laptop).
if [ -n "$NEW_RELIC_USER_KEY" ] && [ -n "$NEW_RELIC_ENTITY_GUID" ]; then
  echo "Notifying New Relic of revision release $REVISION"
  curl -sS https://api.newrelic.com/graphql \
    --header "Content-Type: application/json" \
    --header "API-Key: $NEW_RELIC_USER_KEY" \
    --data '{
      "query": "mutation($guid: EntityGuid!, $version: String!, $commit: String) { changeTrackingCreateDeployment(deployment: { entityGuid: $guid, version: $version, commit: $commit }) { deploymentId } }",
      "variables": {
        "guid": "'"$NEW_RELIC_ENTITY_GUID"'",
        "version": "'"$REVISION"'",
        "commit": "'"$REVISION"'"
      }
    }'
  echo
else
  echo "Skipping New Relic deploy marker (NEW_RELIC_USER_KEY / NEW_RELIC_ENTITY_GUID not set)"
fi
