<div class="space-y-6">
  <%= render partial: 'user', locals: { user: @user } %>

  <div>
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-wider text-fg-faint">Tracks</h2>
    <% if @assets.any? %>
      <div class="space-y-3"><%= render partial: 'admin/assets/asset', collection: @assets %></div>
    <% else %>
      <p class="text-sm text-fg-muted">No tracks.</p>
    <% end %>
  </div>

  <div>
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-wider text-fg-faint">Comments</h2>
    <% if @comments.any? %>
      <div class="space-y-3"><%= render partial: 'admin/comments/comment', collection: @comments %></div>
    <% else %>
      <p class="text-sm text-fg-muted">No comments.</p>
    <% end %>
  </div>

  <div class="rounded-xl border border-border bg-surface-raised p-4">
    <h2 class="mb-1 text-sm font-semibold uppercase tracking-wider text-fg-faint">Origin story</h2>
    <p class="text-sm text-fg-muted">
      <% if (mass_invite = @user.mass_invite) %>
        Created through the mass invite '<%= mass_invite.name %>'.
      <% elsif (invited_by = @user.invited_by) %>
        Invited by <%= "#{invited_by.login} (#{invited_by.email})" %>.
      <% else %>
        Out of darkness, fretted something in its sleeping.
      <% end %>
    </p>
  </div>
</div>
