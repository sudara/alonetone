<div class="space-y-4">
  <%= render 'admin/shared/view_tabs', tabs: admin_user_view_tabs(:bandwidth) %>
  <p class="text-sm text-fg-muted">Top bandwidth consumers (all-time, cached) at ~$0.12/GB.</p>

  <div class="space-y-2">
    <% @users.each do |user| %>
      <div class="flex items-center justify-between gap-3 rounded-xl border border-border bg-surface-raised p-4">
        <div class="flex min-w-0 gap-3">
          <div class="size-10 shrink-0 overflow-hidden rounded-full bg-surface-overlay"><%= user_image(user, variant: :large_avatar) %></div>
          <div class="min-w-0">
            <%= link_to user.name, admin_possibly_deleted_user_path(user.login), class: "block truncate font-semibold text-accent hover:underline" %>
            <p class="text-xs text-fg-faint"><%= user.assets_count %> tracks</p>
          </div>
        </div>
        <div class="shrink-0 text-right">
          <p class="font-semibold"><%= user.bandwidth_used %> GB</p>
          <p class="text-xs text-fg-faint"><%= user.total_bandwidth_cost %></p>
        </div>
      </div>
    <% end %>
  </div>
</div>
