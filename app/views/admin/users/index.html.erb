<% predefined = %w[invited is_spam spam_musicians deleted]
   pills = [
     { label: 'All', url: admin_users_path, active: params[:filter_by].blank? },
     { label: 'Invited', url: admin_users_path(filter_by: 'invited'), active: params[:filter_by] == 'invited' },
     { label: 'Spam', url: admin_users_path(filter_by: 'is_spam'), active: params[:filter_by] == 'is_spam' },
     { label: 'Spam Musicians', url: admin_users_path(filter_by: 'spam_musicians'), active: params[:filter_by] == 'spam_musicians' },
     { label: 'Deleted', url: admin_users_path(filter_by: 'deleted'), active: params[:filter_by] == 'deleted' }
   ] %>

<div class="space-y-4">
  <%= render 'admin/shared/view_tabs', tabs: admin_user_view_tabs(:list) %>

  <%= form_with url: admin_users_path, method: :get, class: "flex gap-2" do |form| %>
    <%= form.search_field :filter_by,
          value: (params[:filter_by] unless predefined.include?(params[:filter_by])),
          placeholder: "Search login, email, or display name…",
          class: "w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-fg placeholder:text-fg-faint focus:border-accent focus:outline-none" %>
    <%= form.submit "Search", class: "shrink-0 cursor-pointer rounded-lg bg-accent px-3 py-2 text-sm font-semibold text-accent-fg hover:bg-accent-hover" %>
  <% end %>

  <%= render 'admin/shared/filter_pills', pills: pills %>

  <% if @users.any? %>
    <div class="space-y-3"><%= render partial: 'user', collection: @users %></div>
  <% else %>
    <p class="rounded-xl border border-border bg-surface-raised p-6 text-sm text-fg-muted">No users here.</p>
  <% end %>

  <%= render 'admin/shared/pagination' %>
</div>
