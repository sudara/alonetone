<div class="space-y-4">
  <%= render 'admin/shared/view_tabs', tabs: admin_user_view_tabs(:shared_ips) %>
  <p class="text-sm text-fg-muted">IPs used by multiple accounts (by current login IP) — possible shared or duplicate logins.</p>

  <div class="space-y-2">
    <% @shared_ips.each do |ip, count| %>
      <% next if ip.blank? %>
      <div class="rounded-xl border border-border bg-surface-raised p-4">
        <div class="flex items-center justify-between gap-3">
          <%= link_to ip, "https://www.botsvsbrowsers.com/ip/#{ip}", target: "_blank", rel: "noopener", class: "font-mono text-sm text-accent hover:underline" %>
          <span class="shrink-0 rounded-full bg-surface-overlay px-2 py-0.5 text-xs font-medium text-fg-muted"><%= count %> accounts</span>
        </div>
        <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm">
          <% @users_by_ip.fetch(ip, []).each do |user| %>
            <%= link_to user.name, admin_possibly_deleted_user_path(user.login), class: "text-accent hover:underline" %>
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
</div>
