<div class="space-y-4">
  <%= render 'admin/shared/view_tabs', tabs: admin_user_view_tabs(:shared_ips) %>
  <p class="text-sm text-fg-muted">IPs used by multiple accounts (by current login IP) — possible shared or duplicate logins.</p>

  <div class="space-y-2">
    <% @shared_ips.each do |ip, count| %>
      <% next if ip.blank? %>
      <div class="rounded-xl border border-border bg-surface-raised p-4">
        <div class="flex items-center justify-between gap-3">
          <%= link_to ip, admin_ip_lookup_url(ip), target: "_blank", rel: "noopener", class: "font-mono text-sm text-accent hover:underline" %>
          <div class="flex shrink-0 flex-wrap justify-end gap-2">
            <span class="rounded-full bg-surface-overlay px-2 py-0.5 text-xs font-medium text-fg-muted"><%= pluralize(count, 'account') %></span>
            <span class="rounded-full bg-surface-overlay px-2 py-0.5 text-xs font-medium text-fg-muted"><%= pluralize(@track_counts_by_ip.fetch(ip, 0), 'track') %></span>
          </div>
        </div>
        <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm">
          <% previewed_users = @users_by_ip.fetch(ip, []) %>
          <% previewed_users.each do |user| %>
            <%= link_to user.login, admin_possibly_deleted_user_path(user.login), class: "text-accent hover:underline" %>
          <% end %>
          <% if count > previewed_users.size %>
            <span class="text-fg-faint">and <%= pluralize(count - previewed_users.size, 'more account') %></span>
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
</div>
