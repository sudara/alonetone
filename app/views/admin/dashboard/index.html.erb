<div class="space-y-6">
  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <% [["New users", @stats.new_users], ["New tracks", @stats.new_tracks],
        ["New comments", @stats.new_comments], ["Listens", @stats.listens]].each do |label, value| %>
      <div class="rounded-xl border border-border bg-surface-raised p-4">
        <p class="text-sm text-fg-muted"><%= label %></p>
        <p class="mt-1 text-2xl font-semibold"><%= number_with_delimiter(value) %></p>
      </div>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= link_to admin_account_requests_path, class: "inline-flex items-center gap-2 rounded-full border border-border bg-surface-raised px-3 py-1.5 text-sm text-fg-muted hover:text-fg" do %>
      <span class="font-semibold text-fg"><%= @stats.waiting_account_requests %></span> waiting requests
    <% end %>
    <%= link_to admin_users_path(filter_by: 'is_spam'), class: "inline-flex items-center gap-2 rounded-full border border-border bg-surface-raised px-3 py-1.5 text-sm text-fg-muted hover:text-fg" do %>
      <span class="font-semibold text-fg"><%= @stats.spam_users %></span> spam users
    <% end %>
    <%= link_to admin_assets_path(filter_by: 'is_spam'), class: "inline-flex items-center gap-2 rounded-full border border-border bg-surface-raised px-3 py-1.5 text-sm text-fg-muted hover:text-fg" do %>
      <span class="font-semibold text-fg"><%= @stats.spam_tracks %></span> spam tracks
    <% end %>
    <%= link_to admin_comments_path(filter_by: 'is_spam'), class: "inline-flex items-center gap-2 rounded-full border border-border bg-surface-raised px-3 py-1.5 text-sm text-fg-muted hover:text-fg" do %>
      <span class="font-semibold text-fg"><%= @stats.spam_comments %></span> spam comments
    <% end %>
    <%= link_to admin_devops_path, class: "inline-flex items-center gap-2 rounded-full border border-border bg-surface-raised px-3 py-1.5 text-sm text-fg-muted hover:text-fg" do %>
      <span class="font-semibold text-fg"><%= @stats.perma_deletable %></span> purgeable (30d+)
    <% end %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <% [["New users", @stats.new_users_series], ["New tracks", @stats.new_tracks_series],
        ["New comments", @stats.new_comments_series], ["Listens", @stats.listens_series]].each do |title, data| %>
      <% next if data.nil? %>
      <div class="rounded-xl border border-border bg-surface-raised p-4">
        <p class="mb-3 text-sm font-medium text-fg-muted"><%= title %></p>
        <%= line_chart data, **admin_chart_options, height: "220px" %>
      </div>
    <% end %>
  </div>
</div>
