<div class="space-y-4">
  <%= render 'admin/shared/view_tabs', tabs: admin_listen_view_tabs(:banned) %>

  <% if admin? %>
    <%= form_with url: admin_ban_ip_path, method: :post, class: "flex gap-2" do |form| %>
      <%= form.text_field :ip, placeholder: "203.0.113.9 or 47.82.0.0/16", required: true,
            class: "w-72 rounded-lg border border-border bg-surface px-3 py-2 text-sm text-fg focus:border-accent focus:outline-none" %>
      <%= form.submit "Ban", class: admin_btn(:danger) %>
    <% end %>
  <% end %>

  <% if @banned_ips.any? %>
    <div class="space-y-2">
      <% @banned_ips.each do |banned| %>
        <div class="flex items-center justify-between gap-3 rounded-xl border border-border bg-surface-raised p-4">
          <div class="min-w-0">
            <p class="font-mono text-sm"><%= banned.ip %></p>
            <p class="text-xs text-fg-faint">
              banned <%= local_time_ago banned.created_at %><% if banned.banned_by %> by <%= banned.banned_by.login %><% end %>
            </p>
            <% impacted_users = @users_by_banned_ip.fetch(banned.id, []) %>
            <p class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs">
              <span class="text-fg-faint">Impacted accounts:</span>
              <% if impacted_users.any? %>
                <% impacted_users.each do |user| %>
                  <%= link_to user.login, admin_possibly_deleted_user_path(user.login), class: "text-accent hover:underline" %>
                <% end %>
              <% else %>
                <span class="text-fg-faint">none by login IP</span>
              <% end %>
            </p>
          </div>
          <% if admin? %>
            <div class="flex shrink-0 gap-2">
              <% if banned.purgeable_listens? %>
                <% listen_count = @listen_counts_by_banned_ip.fetch(banned.id, 0) %>
                <%= button_to "Purge #{number_with_delimiter(listen_count)} listens", admin_purge_banned_ip_path(banned), method: :post, class: admin_btn(:danger),
                      form: { data: { turbo_confirm: "Permanently delete #{number_with_delimiter(listen_count)} listens from #{banned.ip}? Artist play counts will drop. This cannot be undone." } } %>
              <% end %>
              <%= button_to "Unban", admin_banned_ip_path(banned), method: :delete, class: admin_btn(:neutral) %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="rounded-xl border border-border bg-surface-raised p-6 text-sm text-fg-muted">No banned IPs yet. Ban one from Listening IPs.</p>
  <% end %>
</div>
