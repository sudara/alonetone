<% pills = [
  { label: 'All', url: admin_comments_path, active: params[:filter_by].blank? },
  { label: 'Spam', url: admin_comments_path(filter_by: 'is_spam'), active: params[:filter_by] == 'is_spam' }
] %>

<div class="space-y-4">
  <%= render 'admin/shared/filter_pills', pills: pills %>

  <% if @comments.any? %>
    <div class="space-y-3"><%= render partial: 'comment', collection: @comments %></div>
  <% else %>
    <p class="rounded-xl border border-border bg-surface-raised p-6 text-sm text-fg-muted">No comments here.</p>
  <% end %>

  <%= render 'admin/shared/pagination' %>
</div>
