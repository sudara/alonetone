<div data-mass-invite class="flex items-center justify-between gap-3 rounded-xl border border-border bg-surface-raised p-4">
  <div class="min-w-0">
    <p class="truncate font-semibold"><%= mass_invite.name %></p>
    <p class="text-xs text-fg-faint"><%= l(mass_invite.created_at, format: :short) %> · <%= mass_invite.users_count %> users</p>
    <%= link_to mass_invite.token, mass_invite_url(mass_invite), class: "break-all text-sm text-accent hover:underline" %>
  </div>
  <div class="shrink-0">
    <% if mass_invite.archived? %>
      <%= button_to 'Activate', admin_mass_invite_path(mass_invite, mass_invite: { archived: 0 }), method: :patch,
            class: "rounded-lg border border-border bg-surface-overlay px-3 py-1.5 text-sm text-fg-muted hover:text-fg" %>
    <% else %>
      <%= button_to 'Archive', admin_mass_invite_path(mass_invite, mass_invite: { archived: 1 }), method: :patch,
            class: "rounded-lg border border-border bg-surface-overlay px-3 py-1.5 text-sm text-fg-muted hover:text-fg" %>
    <% end %>
  </div>
</div>
