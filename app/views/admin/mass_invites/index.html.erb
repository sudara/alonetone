<% pills = [
  { label: 'Active', url: admin_mass_invites_path, active: params[:filter_by] != 'archived' },
  { label: 'Archived', url: admin_mass_invites_path(filter_by: 'archived'), active: params[:filter_by] == 'archived' }
] %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3">
    <%= render 'admin/shared/filter_pills', pills: pills %>
    <%= link_to 'New invite', new_admin_mass_invite_path,
          class: "shrink-0 rounded-lg bg-accent px-3 py-1.5 text-sm font-semibold text-accent-fg hover:bg-accent-hover" %>
  </div>

  <% if @mass_invites.any? %>
    <div class="space-y-3"><%= render @mass_invites %></div>
  <% else %>
    <p class="rounded-xl border border-border bg-surface-raised p-6 text-sm text-fg-muted">No mass invites here.</p>
  <% end %>

  <%= render 'admin/shared/pagination' %>
</div>
