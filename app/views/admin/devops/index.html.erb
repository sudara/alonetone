<div class="space-y-6">
  <div>
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-wider text-fg-faint">Tools</h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% akismet_url = "https://akismet.com/web/1.0/user-stats.php?blog=alonetone.com&api_key=#{Rails.configuration.alonetone.rakismet_key}" %>
      <% tools = [
           ["Job status", "/sidekiq", "Sidekiq queues and workers"],
           ["Akismet stats", akismet_url, "Spam filtering dashboard"],
           ["Postmark stats", "https://account.postmarkapp.com/servers/2804035/streams", "Transactional email delivery"]
         ] %>
      <% tools.each do |label, url, description| %>
        <%= link_to url, target: "_blank", rel: "noopener",
              class: "group flex items-start justify-between gap-2 rounded-xl border border-border bg-surface-raised p-4 hover:border-border-strong" do %>
          <span class="min-w-0">
            <span class="block font-medium text-fg"><%= label %></span>
            <span class="block text-xs text-fg-muted"><%= description %></span>
          </span>
          <span class="shrink-0 text-fg-faint group-hover:text-accent">↗</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <div>
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-wider text-fg-faint">Perma-delete sweep</h2>
    <div class="space-y-3 rounded-xl border border-border bg-surface-raised p-4">
      <p class="text-sm text-fg">
        <span class="font-semibold"><%= @destroyable_users_count %></span> accounts,
        <span class="font-semibold"><%= @destroyable_assets_count %></span> tracks, and
        <span class="font-semibold"><%= @destroyable_comments_count %></span> comments soft-deleted more than 30 days ago are eligible for permanent deletion.
      </p>
      <p class="text-xs text-fg-faint">The automatic 30-day sweep runs via system cron; this triggers it on demand.</p>

      <% if @destroyable_users.any? %>
        <div>
          <h3 class="mb-1 text-xs font-semibold uppercase tracking-wider text-fg-faint">Accounts</h3>
          <ul class="divide-y divide-border text-sm">
            <% @destroyable_users.each do |user| %>
              <li class="flex items-center justify-between gap-3 py-1.5">
                <%= link_to user.login, admin_possibly_deleted_user_path(user.login), class: "truncate text-accent hover:underline" %>
                <span class="shrink-0 text-xs text-fg-faint">deleted <%= local_time_ago user.deleted_at %></span>
              </li>
            <% end %>
          </ul>
          <% if @destroyable_users_count > @destroyable_users.size %>
            <p class="mt-1 text-xs text-fg-faint">…and <%= @destroyable_users_count - @destroyable_users.size %> more.</p>
          <% end %>
        </div>
      <% end %>

      <% if @destroyable_assets.any? %>
        <div>
          <h3 class="mb-1 text-xs font-semibold uppercase tracking-wider text-fg-faint">Tracks</h3>
          <ul class="divide-y divide-border text-sm">
            <% @destroyable_assets.each do |asset| %>
              <li class="flex items-center justify-between gap-3 py-1.5">
                <span class="truncate"><%= asset.title %><% if asset.possibly_deleted_user %> <span class="text-fg-muted">by <%= asset.possibly_deleted_user.login %></span><% end %></span>
                <span class="shrink-0 text-xs text-fg-faint">deleted <%= local_time_ago asset.deleted_at %></span>
              </li>
            <% end %>
          </ul>
          <% if @destroyable_assets_count > @destroyable_assets.size %>
            <p class="mt-1 text-xs text-fg-faint">…and <%= @destroyable_assets_count - @destroyable_assets.size %> more.</p>
          <% end %>
        </div>
      <% end %>

      <% if @destroyable_comments.any? %>
        <div>
          <h3 class="mb-1 text-xs font-semibold uppercase tracking-wider text-fg-faint">Comments</h3>
          <ul class="divide-y divide-border text-sm">
            <% @destroyable_comments.each do |comment| %>
              <li class="flex items-center justify-between gap-3 py-1.5">
                <span class="truncate"><%= truncate(comment.body, length: 80) %></span>
                <span class="shrink-0 text-xs text-fg-faint">deleted <%= local_time_ago comment.deleted_at %></span>
              </li>
            <% end %>
          </ul>
          <% if @destroyable_comments_count > @destroyable_comments.size %>
            <p class="mt-1 text-xs text-fg-faint">…and <%= @destroyable_comments_count - @destroyable_comments.size %> more.</p>
          <% end %>
        </div>
      <% end %>

      <% if admin? && (@destroyable_users_count.positive? || @destroyable_assets_count.positive? || @destroyable_comments_count.positive?) %>
        <%= button_to "Purge eligible now", admin_devops_purge_path, method: :post, class: admin_btn(:danger),
              form: { data: { turbo_confirm: "Permanently delete eligible accounts, tracks, and comments soft-deleted more than 30 days ago? This cannot be undone." } } %>
      <% end %>
    </div>
  </div>
</div>
