<% pills = [
  { label: 'All', url: admin_assets_path, active: params[:filter_by].blank? },
  { label: 'Spam', url: admin_assets_path(filter_by: 'is_spam'), active: params[:filter_by] == 'is_spam' },
  { label: 'Deleted', url: admin_assets_path(filter_by: 'deleted'), active: params[:filter_by] == 'deleted' }
] %>

<div class="space-y-4">
  <%= render 'admin/shared/view_tabs', tabs: admin_track_view_tabs(:list) %>

  <%= render 'admin/shared/filter_pills', pills: pills %>

  <% if @assets.any? %>
    <div class="space-y-3"><%= render partial: 'asset', collection: @assets %></div>
  <% else %>
    <p class="rounded-xl border border-border bg-surface-raised p-6 text-sm text-fg-muted">No tracks here.</p>
  <% end %>

  <%= render 'admin/shared/pagination' %>
</div>
