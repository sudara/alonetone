<div class="space-y-4">
  <%= render 'admin/shared/view_tabs', tabs: admin_track_view_tabs(:most_played) %>

  <% if @play_counts.any? %>
    <div class="space-y-2">
      <% @play_counts.each do |asset_id, plays| %>
        <% asset = @assets_by_id[asset_id]; next unless asset %>
        <div class="flex items-center justify-between gap-3 rounded-xl border border-border bg-surface-raised p-4">
          <div class="min-w-0">
            <%= link_to asset.title, user_track_path(asset.possibly_deleted_user, asset.permalink), class: "block truncate font-semibold text-accent hover:underline" %>
            <p class="text-sm text-fg-muted">by <%= asset.possibly_deleted_user.login %></p>
          </div>
          <span class="shrink-0 font-semibold"><%= number_with_delimiter(plays) %> plays</span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="rounded-xl border border-border bg-surface-raised p-6 text-sm text-fg-muted">No plays in this range.</p>
  <% end %>
</div>
