<%= tag.div id: dom_id(asset), class: class_names(
      "rounded-xl border bg-surface-raised p-4",
      "border-danger/40" => asset.is_spam?,
      "border-border" => !asset.is_spam?
    ) do %>
  <div class="flex min-w-0 gap-3">
    <div class="size-10 shrink-0 overflow-hidden rounded-full bg-surface-overlay"><%= user_image(asset.possibly_deleted_user, variant: :large_avatar) %></div>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <% if asset.possibly_deleted_user %>
          <%= link_to asset.title, user_track_path(asset.possibly_deleted_user, asset.permalink), class: "truncate font-semibold text-accent hover:underline" %>
        <% else %>
          <span class="truncate font-semibold"><%= asset.title %></span>
        <% end %>
        <% if asset.is_spam? %><span class="rounded-full bg-danger/15 px-2 py-0.5 text-xs font-medium text-danger-hover">spam</span><% end %>
        <% if asset.soft_deleted? %><span class="rounded-full bg-surface-overlay px-2 py-0.5 text-xs text-fg-muted">deleted</span><% end %>
      </div>
      <p class="truncate text-sm text-fg-muted">
        <% if asset.possibly_deleted_user %>
          by <%= link_to asset.possibly_deleted_user.login, admin_possibly_deleted_user_path(asset.possibly_deleted_user.login), class: "hover:text-fg" %>
        <% else %>
          by a permanently deleted account
        <% end %>
      </p>
      <p class="text-xs text-fg-faint">
        <%= asset.created_at.strftime("%b %d, %Y") %> · <%= asset.listens_count %> listens · <%= asset.comments_count %> comments
        <% if asset.deleted_at %> · deleted <%= local_time_ago asset.deleted_at %><% end %>
      </p>
    </div>
  </div>

  <% if asset.description.present? %>
    <p class="mt-2 line-clamp-2 text-sm text-fg-muted"><%= truncate(asset.description, length: 120) %></p>
  <% end %>

  <% unless asset.possibly_deleted_user&.soft_deleted? %>
    <div class="mt-3 flex flex-wrap gap-2">
      <% if asset.soft_deleted? %>
        <%= button_to "Restore", restore_admin_asset_path(id: asset.id, row: true), method: :put, class: admin_btn(:neutral) %>
        <% if asset.perma_deletable? %>
          <%= button_to "Permanently delete", purge_admin_asset_path(asset.id), method: :delete, class: admin_btn(:danger),
                data: { turbo_confirm: "Permanently delete \"#{asset.title}\"? This cannot be undone." } %>
        <% end %>
      <% else %>
        <%= button_to "Spam", spam_admin_asset_path(id: asset.id, row: true), method: :put, class: admin_btn(:neutral),
              data: { turbo_confirm: "Mark \"#{asset.title}\" as spam? This also hides it from the site." } %>
        <%= button_to "Delete", delete_admin_asset_path(id: asset.id, row: true), method: :put, class: admin_btn(:neutral),
              data: { turbo_confirm: "Delete \"#{asset.title}\"? It can be restored for 30 days." } %>
      <% end %>
    </div>
  <% end %>
<% end %>
