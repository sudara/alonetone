<% pills = [
  { label: 'All', url: admin_account_requests_path, active: params[:filter_by].blank? },
  { label: 'Waiting', url: admin_account_requests_path(filter_by: 'candidates'), active: params[:filter_by] == 'candidates' },
  { label: 'Spammers', url: admin_account_requests_path(filter_by: 'spammers'), active: params[:filter_by] == 'spammers' },
  { label: 'Claimed', url: admin_account_requests_path(filter_by: 'claimed'), active: params[:filter_by] == 'claimed' },
  { label: 'Approved', url: admin_account_requests_path(filter_by: 'approved'), active: params[:filter_by] == 'approved' },
  { label: 'Denied', url: admin_account_requests_path(filter_by: 'denied'), active: params[:filter_by] == 'denied' }
] %>

<div class="space-y-4">
  <%= render 'admin/shared/filter_pills', pills: pills %>

  <% if @account_requests.any? %>
    <div class="space-y-3">
      <%= render partial: 'account_request', collection: @account_requests %>
    </div>
  <% else %>
    <p class="rounded-xl border border-border bg-surface-raised p-6 text-sm text-fg-muted">No account requests here.</p>
  <% end %>

  <%= render 'admin/shared/pagination' %>
</div>
