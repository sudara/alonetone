<!DOCTYPE html>
<html class="<%= 'dark' if dark_theme? %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title><%= [@admin_title, 'alonetone admin'].compact.join(' · ') %></title>
  <%= csrf_meta_tag %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'admin' %>
  <%= javascript_include_tag 'application', 'data-turbo-track': 'reload', defer: true %>
</head>

<body class="min-h-screen bg-surface text-fg antialiased lg:flex">
  <input type="checkbox" id="admin-nav-toggle" class="peer sr-only">

  <label for="admin-nav-toggle" aria-hidden="true"
         class="fixed inset-0 z-30 hidden bg-black/60 peer-checked:block lg:hidden"></label>

  <aside class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-border bg-surface-raised transition-transform duration-200 peer-checked:translate-x-0 lg:static lg:translate-x-0 lg:shrink-0">
    <%= render 'admin/shared/nav' %>
  </aside>

  <div class="flex min-w-0 flex-1 flex-col">
    <header class="sticky top-0 z-20 flex items-center gap-3 border-b border-border bg-surface/95 px-4 py-3 backdrop-blur">
      <label for="admin-nav-toggle"
             class="-ml-1 cursor-pointer rounded-md p-1.5 text-fg-muted hover:bg-surface-overlay hover:text-fg lg:hidden">
        <%= admin_icon :menu, css: "size-6" %>
        <span class="sr-only">Open menu</span>
      </label>

      <h1 class="text-base font-semibold"><%= @admin_title || controller_name.titleize %></h1>

      <% if @admin_range_enabled %>
        <div class="ml-auto"><%= render 'admin/shared/range_selector' %></div>
      <% end %>
    </header>

    <main class="flex-1 p-4 sm:p-6"><%= yield %></main>
  </div>
</body>
</html>
