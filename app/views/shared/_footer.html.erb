<% if User.currently_online.count > 2 %>
<div class="footer_alonetoners_online">
  <h3>Alonetoners online</h3>
    <div>
      <%= safe_join(User.currently_online.map { |user| link_to user.name, main_app.user_home_path(user.login) }, ', ') %>
    </div>
</div>
<% end %>

<% if logged_in? %>
<div class="footer_forum_topics" data-turbo="false">
  <div class="footer_forum_topics_inner">
    <a href="https://forum.alonetone.com/" class="forum_view_all" target="_blank" rel="noopener">
        Check out the new forums... &nbsp;<i class="icon_caret">
        <%== render file: svg_path('svg/icon_caret.svg') %>
        </i>
    </a>
    <h3>Latest forum topics</h3>
    <ul>
      <% topics = ForumTopics.latest %>
      <% if topics.any? %>
        <% topics.each do |topic| %>
          <li>
            <%= link_to topic.title, topic.url, target: "_blank", rel: "noopener" %>
            <% if topic.author %>
              <div>by <%= link_to topic.author, topic.author_url, target: "_blank", rel: "noopener" %></div>
            <% end %>
          </li>
        <% end %>
      <% else %>
        <li>
          <%= link_to "Welcome to the new forums", "https://forum.alonetone.com/t/welcome-to-the-new-alonetone-forum", target: "_blank", rel: "noopener" %>
          <div>by <%= link_to "sudara", "https://forum.alonetone.com/t/welcome-to-the-new-alonetone-forum", target: "_blank", rel: "noopener" %></div>
        </li>
      <% end %>
    </ul>
  </div>
</div>
<% end %>

<div class="footer_bottom">
  <div class="footer_columns">
    <div class="footer_column">
      <h3 class="footer_column_header">alone<em>tone</em> radio</h3>
      <a href="/radio/">
        <%== render file: svg_path('svg/icon_radio.svg') %>
      </a>
    </div>

    <div class="footer_column">
      <h3 class="footer_column_header">Browse</h3>
      <div><%= link_to "All Artists", "/users"%></div>
      <div><%= link_to "Recent Playlists", "/playlists"%></div>
      <div><%= link_to "Recent Tracks", "/radio"%></div>
      <div><%= link_to "Popular Tracks", "/radio/popular"%></div>
    </div>

    <div class="footer_column">
      <h3 class="footer_column_header">Do Stuff</h3>
    <% if logged_in? %>
      <div><%= link_to "Upload", "/upload"%></div>
      <div><%= link_to "New Playlist/Album", "/new_album"%></div>
    <% end %>
      <div><%= link_to "Get An Account", "/get_an_account"%></div>
    <% if moderator? %>
      <div><%= link_to "Admin", "/admin/users" %></div>
    <% end %>
      </div>

    <div class="footer_column">
      <h3 class="footer_column_header">More</h3>
      <div><%= link_to "About", "/about"%></div>
      <div data-turbo="false"><%= link_to "Forum (back up in 2026!)", "https://forum.alonetone.com", target: "_blank", rel: "noopener" %></div>
      <div data-turbo="false"><%= link_to "Community Guidelines", 'https://forum.alonetone.com/guidelines', target: "_blank", rel: "noopener" %></div>
      <div><%= link_to "✨Support alonetone on Patreon", 'https://patreon.com/alonetone' %></div>
    </div>

  </div>
</div>
